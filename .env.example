# Copy this file to `.env` and fill in values for your machine.
# All scripts and Python entry points in this repo reference these variables.

# --- Repository layout ---
SPEECHBENCH_REPO_DIR=/path/to/SEA-SpeechBench

# --- Data / results ---
DATA_ROOT=/path/to/data
OUTPUT_ROOT=/path/to/results

# --- HuggingFace caches ---
HF_HOME=/path/to/hf_cache
HF_DATASETS_CACHE=${HF_HOME}/datasets
HF_HUB_CACHE=${HF_HOME}/hub

# --- Cluster (PBS + Enroot) ---
SCRATCH_ROOT=/path/to/scratch
CONTAINER_DIR=/path/to/containers          # holds speechbench.sqsh
NLTK_DATA=${HOME}/nltk_data

# --- API keys (only needed for the corresponding model / judge) ---
HF_TOKEN=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
GEMINI_API_KEY=
